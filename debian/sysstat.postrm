#!/bin/sh
# vim:ts=4:et

PACKAGE="sysstat"
DEFAULT="/etc/default/$PACKAGE"

set -e
# remove logfiles and default file when package is purged
if [ "$1" =  "purge" ] ; then
    rm -rf /var/log/sysstat
    rm -f "$DEFAULT"
    ! command -v ucf >/dev/null || ucf --purge "$DEFAULT"
    ! command -v ucfr >/dev/null || ucfr --purge "$PACKAGE" "$DEFAULT"
fi

#DEBHELPER#

exit 0
